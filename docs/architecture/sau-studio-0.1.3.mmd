flowchart LR
  subgraph Desktop["Electron 桌面端 v0.1.3"]
    subgraph Renderer["渲染进程 · BrowserWindow · 沙箱隔离"]
      UI["Vue 3 / TypeScript / Vite / Element Plus<br/>工作台、发布中心、草稿箱、素材库<br/>账号、任务、记录、设置"]
      State["Pinia 工作区<br/>草稿、主题、数据快照、列表分页"]
      UI <--> State
    end
    Preload["preload.ts / contextBridge<br/>window.sauDesktop · 类型化 IPC"]
    Main["main.ts<br/>窗口、托盘、单实例、退出生命周期<br/>app:// 页面 · sau-media:// 素材协议"]
    Service["StudioService / service.ts<br/>账号与素材管理、任务校验<br/>每秒调度到期任务、并发上限 2、同账号互斥<br/>平台参数缓存、请求去重、串行读取"]
    Store["StudioStore / store.ts<br/>SQLite WAL、事务、索引、重启恢复"]
    Manager["worker.ts<br/>受控子进程、进程树中断<br/>日志脱敏、结构化结果、临时传输文件回收"]
    State <-->|"IPC 请求 / 响应"| Preload
    Preload <--> Main
    Main --> Service
    Service <--> Store
    Service --> Manager
    Service -.->|"studio:changed → 合并刷新快照"| State
  end
  subgraph Execution["独立 Python 操作进程"]
    Worker["sau-worker.exe / Python 3.12 / PyInstaller<br/>desktop/python/worker.py<br/>参数、登录、检查、发布"]
    Core["共享上传核心<br/>sau_commands → uploader"]
    Worker --> Core
  end
  Manager -->|"request.json / 启动进程"| Worker
  Worker -.->|"result.json / 诊断日志"| Manager
  Manager -.->|"结果 / 日志回调"| Service
  subgraph Runtime["平台运行环境"]
    Patchright["Patchright + 独立 Node<br/>Chromium 1208 · 多数浏览器平台"]
    Playwright["Playwright + 独立 Node<br/>Chromium 1254 · TikTok"]
    Biliup["biliup.exe<br/>Bilibili 登录 / 上传"]
    Helpers["文章与媒体工具<br/>Markdown → HTML，渲染复用 Electron Node<br/>OpenCV / NumPy：二维码与媒体校验"]
  end
  Core --> Patchright
  Core --> Playwright
  Core --> Biliup
  Core --> Helpers
  Platforms["17 社交平台<br/>抖音、小红书、快手、视频号、Bilibili、百家号、大鱼号<br/>支付宝生活号、微博、虎扑、雪球、知乎、YouTube、TikTok<br/>Facebook、Facebook Page、Instagram<br/>视频 / 图文 / 文章，按平台支持"]
  Patchright -->|"浏览器交互"| Platforms
  Playwright -->|"浏览器交互"| Platforms
  Biliup -->|"CLI"| Platforms
  subgraph Data["本机数据 · userData/workspace"]
    DB[("studio.sqlite3<br/>settings / accounts / materials / tasks / events")]
    Files["cookies / login_qr / jobs / results / logs"]
  end
  Originals["素材原文件<br/>保留原位置，只保存文件引用"]
  Store <--> DB
  Worker <--> Files
  Service --> Originals
  Main -->|"sau-media:// 读取"| Originals
  CLI["独立 CLI / Agent Skills"] -.-> Core
  Preview["独立 Web 预览<br/>示例数据 / localStorage"]
  Legacy["历史 Web → Flask HTTP 服务<br/>不参与桌面启动"]
  Legacy -.-> Core
